# Copy this file as .env and fill in your real values.
# NEVER commit a .env file filled with real values.

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_SYSTEM_PROMPT=You are Nova, a helpful, friendly AI assistant.
GEMINI_WEB_SEARCH_ENABLED=true

# Tavily (web search)
TAVILY_API_KEY=your-tavily-api-key

# CORS - origin where the frontend runs
FRONTEND_ORIGIN=http://localhost:3000

# This API's public URL (for the openapi.json servers field)
BACKEND_URL=http://localhost:8000

# Image upload limit (MB)
MAX_IMAGE_SIZE_MB=8.0

# development | production
ENVIRONMENT=development
